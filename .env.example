DEMO_MODE=true
PORT=3333
DATABASE_URL=postgresql://netvision:netvision@localhost:5432/netvision?schema=public&connection_limit=10&pool_timeout=20
# connection_limit: teto de conexoes do pool UNICO do processo (a API usa
# um PrismaClient desde a fase db-pool; sem teto o padrao do Prisma e
# cpus*2+1 e o Postgres estoura quando ha muitos servicos no host).
CREDENTIAL_ENCRYPTION_KEY=
ZABBIX_URL=
ZABBIX_TOKEN=
ZABBIX_AUTH_MODE=AUTH_FIELD
OPTICAL_POLL_INTERVAL_SECONDS=300
SESSION_TTL_DAYS=7
DEMO_ADMIN_PASSWORD=admin
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@netvision.local
DEFAULT_ADMIN_NAME=Administrador
DEFAULT_ADMIN_PASSWORD=admin
NEXT_PUBLIC_API_URL=
API_INTERNAL_URL=http://127.0.0.1:3333
