generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MapMode {
  MANUAL
  AUTO
  HYBRID
}

enum PositionSource {
  AUTO
  MANUAL
}

enum NodeKind {
  DEVICE
  GENERIC
}

enum NodeDisplayMode {
  ICON_2D
  ICON_3D
  CARD
}

enum LinkDisplayStyle {
  FLOW
  WEATHERMAP
  HYBRID
  MINIMAL
}

enum LinkMetricDisplay {
  THROUGHPUT
  UTILIZATION
  BOTH
  NONE
}

enum TrafficLabelMode {
  CARD
  INLINE
  HIDDEN
}

enum CapacitySource {
  AUTO
  MANUAL
}

enum LinkAggregationMode {
  NONE
  SUM
}

enum LinkLayoutMode {
  AUTO
  MANUAL
}

enum LinkHandleSide {
  AUTO
  TOP
  RIGHT
  BOTTOM
  LEFT
}

enum TrafficMode {
  BIDIRECTIONAL
  SINGLE_ENDED
}

enum DeviceStatus {
  UP
  DOWN
  WARNING
  UNKNOWN
}

enum InterfaceStatus {
  UP
  DOWN
  DISABLED
  WARNING
  UNKNOWN
}

enum AlarmType {
  INTERFACE_DOWN
}

enum AlarmSeverity {
  CRITICAL
  MAJOR
  WARNING
  INFO
}

enum DiscoverySource {
  MANUAL
  LLDP_SNMP
  LLDP_SSH
}

enum DiscoveryJobStatus {
  PENDING
  RUNNING
  REVIEW
  COMPLETED
  FAILED
}

enum MatchStatus {
  MATCHED
  UNMATCHED
  AMBIGUOUS
}

enum HostOrigin {
  MANUAL
  ZABBIX
  DISCOVERY
  IMPORTED
}

enum SourceKind {
  ZABBIX
  SSH
  SNMP
}

enum SourceConnectionState {
  DISABLED
  CONFIGURED
  CONNECTED
  FAILED
}

enum SnmpVersion {
  SNMP_V2C
  SNMP_V3
}

enum SnmpSecurityLevel {
  NO_AUTH_NO_PRIV
  AUTH_NO_PRIV
  AUTH_PRIV
}

enum SnmpAuthProtocol {
  MD5
  SHA
  SHA256
}

enum SnmpPrivacyProtocol {
  DES
  AES
  AES256
}

enum Role {
  ADMIN
  OPERATOR
  VIEWER
}

enum PublicViewType {
  MAP
  NOC
}

enum MplsSource {
  SNMP
}

enum MplsStatus {
  UP
  DOWN
  DEGRADED
  ADMIN_DOWN
  UNKNOWN
}

enum MplsVsiOperationalStatus {
  UP
  DOWN
  ADMIN_DOWN
  UNKNOWN
}

enum MplsAdminStatus {
  UP
  DOWN
  UNKNOWN
}

enum MplsAcStatus {
  UP
  DOWN
  UNKNOWN
}

enum MplsPwStatus {
  DOWN
  UP
  PLUG_OUT
  BACKUP
  UNKNOWN
}

enum MplsPwState {
  DOWN
  UP
  UNKNOWN
}

enum MplsPwWorkingState {
  MASTER
  BACKUP
  UNKNOWN
}

enum MplsEntityType {
  VSI
  PW
}

enum BgpPeerRole {
  UPSTREAM
  PEER
  OTHER
}

enum BgpState {
  IDLE
  CONNECT
  ACTIVE
  OPENSENT
  OPENCONFIRM
  ESTABLISHED
  UNKNOWN
}

enum BgpAddressFamily {
  IPV4
  IPV6
}

/**
 * UNKNOWN means no successful read-back has confirmed the admin state yet.
 */
enum BgpAdminState {
  UNKNOWN
  ENABLED
  IGNORED
}

enum BgpAdminAction {
  DISABLE
  ENABLE
}

enum BgpMitigationMode {
  SIMULATION_ONLY
}

enum BgpMitigationProfileMode {
  DISABLED
  ALERT_ONLY
  AUTO
}

enum BgpMitigationState {
  DISABLED
  ALERT_ONLY
  NORMAL
  TRIGGER_PENDING
  MITIGATING
  MITIGATED
  RECOVERY_PENDING
  RECOVERING
  FAILED
  RECONCILIATION_REQUIRED
}

enum BgpMitigationBandwidthSource {
  DESCRIPTION
  MANUAL
  UNKNOWN
}

enum BgpMitigationExclusionReason {
  UPLINK
  TRANSIT
  IX
  BACKBONE
  MANUAL
}

/**
 * Exclusao PREVENTIVA da mitigacao DDoS por PEER BGP ("nunca mitigar este peer").
 *
 * Vive colada ao BgpPeer e NAO depende de existir BgpMitigationProfile: o
 * uplink/transit/IX/backbone sem banda declarada (portanto sem profile) fica
 * protegido hoje e continua protegido se um dia ganhar profile.
 */
model BgpMitigationPeerExclusion {
  id            String                       @id @default(cuid())
  bgpPeerId     String                       @unique
  deviceId      String
  peerAddress   String
  addressFamily BgpAddressFamily             @default(IPV4)
  interfaceId   String?
  reason        BgpMitigationExclusionReason @default(MANUAL)
  note          String?
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt

  peer BgpPeer @relation(fields: [bgpPeerId], references: [id], onDelete: Cascade)

  @@index([deviceId])
  @@index([peerAddress])
  @@index([interfaceId])
}

enum BgpMitigationSimulationResult {
  WOULD_MITIGATE
  WOULD_RECOVER
  NO_ACTION
  BLOCKED
  FAILED
}

enum PhysicalAssetKind {
  NETWORK
  SERVER
  OLT
  DIO
  PATCH_PANEL
  POWER
  GENERIC
}

enum PhysicalPortSide {
  DEVICE
  FRONT
  REAR
}

enum PhysicalPortType {
  RJ45
  SFP
  SFP_PLUS
  QSFP
  FIBER
  POWER
  OTHER
}

enum PhysicalConnectionMedium {
  FIBER
  COPPER
  DAC
  AOC
  UNKNOWN
}

enum PhysicalConnectionEnd {
  A
  B
}

/**
 * SYSTEM templates come from the versioned catalog; CUSTOM are user-defined.
 */
enum PhysicalTemplateOrigin {
  SYSTEM
  CUSTOM
}

/**
 * How a physical port came to exist inside an asset.
 */
enum PhysicalPortRole {
  TEMPLATE
  DISCOVERED
  MANUAL
}

model Map {
  id                String            @id @default(cuid())
  name              String
  description       String            @default("")
  mode              MapMode           @default(HYBRID)
  isDefault         Boolean           @default(false)
  nodeDisplayMode   NodeDisplayMode   @default(ICON_2D)
  linkDisplayStyle  LinkDisplayStyle  @default(HYBRID)
  linkMetricDisplay LinkMetricDisplay @default(BOTH)
  trafficLabelMode  TrafficLabelMode  @default(CARD)
  nodeScale         Float             @default(100)
  linkScale         Float             @default(100)
  labelScale        Float             @default(100)
  viewport          Json?
  filters           Json?
  nodes             MapNode[]
  links             Link[]
  widgets           MapWidget[]
  playlistItems     MapPlaylistItem[]
  publicViews       PublicView[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model MapNode {
  id             String         @id @default(cuid())
  mapId          String
  deviceId       String?
  nodeKind       NodeKind       @default(DEVICE)
  genericType    String?
  label          String?
  x              Float
  y              Float
  locked         Boolean        @default(false)
  positionSource PositionSource @default(AUTO)
  pppDisplayMode String         @default("AUTO")
  pppPosition    String         @default("BOTTOM")
  pppColor       String?
  pppFontSize    Int            @default(14)
  map            Map            @relation(fields: [mapId], references: [id], onDelete: Cascade)
  device         Device?        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  sourceLinks    Link[]         @relation("LinkSourceNode")
  targetLinks    Link[]         @relation("LinkTargetNode")

  @@unique([mapId, deviceId])
  @@index([deviceId])
}

model Device {
  id                   String                 @id @default(cuid())
  name                 String
  displayName          String
  hostname             String
  ip                   String
  managementIp         String
  vendor               String?
  model                String?
  description          String                 @default("")
  notes                String                 @default("")
  origin               HostOrigin             @default(MANUAL)
  status               DeviceStatus           @default(UNKNOWN)
  deviceType           String
  site                 String?
  source               String
  discoveryMethod      String                 @default("AUTO")
  useZabbix            Boolean                @default(false)
  zabbixHostId         String?
  zabbixHostName       String?
  zabbixInterfaceId    String?
  zabbixIp             String?
  sshEnabled           Boolean                @default(false)
  sshHost              String?
  sshPort              Int                    @default(22)
  sshUsername          String?
  sshAuthentication    String?
  sshContextCommand    String?
  snmpEnabled          Boolean                @default(false)
  snmpVersion          SnmpVersion?
  snmpHost             String?
  snmpPort             Int                    @default(161)
  snmpUsername         String?
  snmpSecurityLevel    SnmpSecurityLevel?
  snmpAuthProtocol     SnmpAuthProtocol?
  snmpPrivacyProtocol  SnmpPrivacyProtocol?
  lastPollingAt        DateTime?
  lastDiscoveryAt      DateTime?
  uptimeSeconds        BigInt?
  cpuPercent           Float?
  memoryPercent        Float?
  pppSupported         Boolean                @default(false)
  pppOnline            Int                    @default(0)
  pppUpdatedAt         DateTime?
  pppSource            String?
  bgpMonitoringEnabled Boolean                @default(false)
  /**
   * Local ASN of the BGP process on this device/context, learned via SSH.
   */
  bgpLocalAs           BigInt?
  interfaces           Interface[]
  metricSamples        DeviceMetricSample[]
  mapNodes             MapNode[]
  sourceLinks          Link[]                 @relation("LinkSourceDevice")
  targetLinks          Link[]                 @relation("LinkTargetDevice")
  sourceMappings       DeviceSourceMapping[]
  discoveryJobs        DiscoveryJob[]
  sourceHealth         DeviceSourceHealth[]
  snmpCredentialId     String?
  sshCredentialId      String?
  snmpCredential       SnmpCredential?        @relation(fields: [snmpCredentialId], references: [id])
  sshCredential        SshCredential?         @relation(fields: [sshCredentialId], references: [id])
  mplsState            MplsDeviceState?
  mplsVsis             MplsVsi[]
  mplsPws              MplsPw[]               @relation("MplsPwHost")
  remoteMplsPws        MplsPw[]               @relation("MplsPwRemoteHost")
  mplsStateEvents      MplsStateEvent[]
  bgpPeers             BgpPeer[]
  mitigationProfiles   BgpMitigationProfile[]
  alarms               Alarm[]
  physicalAsset        PhysicalAsset?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  mplsAcs              MplsAc[]

  @@index([hostname])
  @@index([ip])
  @@index([managementIp])
  @@index([zabbixHostId])
}

model Interface {
  id                    String                   @id @default(cuid())
  deviceId              String
  name                  String
  alias                 String?
  description           String?
  ifIndex               Int
  mac                   String?
  mtu                   Int?
  speedBps              BigInt?
  adminStatus           String
  operStatus            InterfaceStatus          @default(UNKNOWN)
  rxPowerDbm            Float?
  txPowerDbm            Float?
  opticalLanes          Json?
  opticalLaneSource     String?
  opticalLanesUpdatedAt DateTime?
  opticalSource         String?
  opticalUpdatedAt      DateTime?
  rxItemId              String?
  txItemId              String?
  statusItemId          String?
  inErrorsItemId        String?
  outErrorsItemId       String?
  inDiscardsItemId      String?
  outDiscardsItemId     String?
  dataSources           Json?
  device                Device                   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  metricSamples         InterfaceMetricSample[]
  opticalSamples        InterfaceOpticalSample[]
  sourceLinks           Link[]                   @relation("LinkSourceInterface")
  targetLinks           Link[]                   @relation("LinkTargetInterface")
  sourceMappings        InterfaceSourceMapping[]
  mplsVsis              MplsVsi[]
  mplsAcs               MplsAc[]
  bgpPeers              BgpPeer[]
  mitigationProfiles    BgpMitigationProfile[]
  alarms                Alarm[]
  physicalPort          PhysicalPort?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@unique([deviceId, ifIndex])
}

model BgpPeer {
  id                     String                     @id @default(cuid())
  deviceId               String
  peerAddress            String
  addressFamily          BgpAddressFamily           @default(IPV4)
  peerDescription        String?
  remoteAs               BigInt?
  interfaceId            String?
  monitoringEnabled      Boolean                    @default(true)
  role                   BgpPeerRole                @default(OTHER)
  adminState             BgpAdminState              @default(UNKNOWN)
  adminStateCheckedAt    DateTime?
  stateCode              Int                        @default(0)
  state                  BgpState                   @default(UNKNOWN)
  established            Boolean                    @default(false)
  receivedPrefixes       BigInt?
  establishedSince       DateTime?
  lastStateChangedAt     DateTime?
  lastPollingAt          DateTime?
  lastDiscoveryAt        DateTime?
  device                 Device                     @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  interface              Interface?                 @relation(fields: [interfaceId], references: [id], onDelete: SetNull)
  samples                BgpPeerSample[]
  stateEvents            BgpPeerStateEvent[]
  adminActions           BgpAdminActionLog[]
  mitigationProfilePeers BgpMitigationProfilePeer[]
  mitigationExclusion    BgpMitigationPeerExclusion?
  createdAt              DateTime                   @default(now())
  updatedAt              DateTime                   @updatedAt

  @@unique([deviceId, peerAddress])
  @@index([deviceId, established])
  @@index([addressFamily])
  @@index([interfaceId])
  @@index([role])
}

/**
 * Audit trail for administrative BGP peer actions. Credentials, raw CLI output
 * and context commands are never stored here.
 */
model BgpAdminActionLog {
  id            String           @id @default(cuid())
  bgpPeerId     String
  deviceId      String
  userId        String?
  username      String?
  peerAddress   String
  addressFamily BgpAddressFamily
  localAs       BigInt?
  remoteAs      BigInt?
  action        BgpAdminAction
  success       Boolean          @default(false)
  verified      Boolean          @default(false)
  errorSafe     String?
  startedAt     DateTime
  completedAt   DateTime?
  bgpPeer       BgpPeer          @relation(fields: [bgpPeerId], references: [id], onDelete: Cascade)

  @@index([bgpPeerId, startedAt])
  @@index([deviceId, startedAt])
}

model BgpPeerSample {
  id               BigInt   @id @default(autoincrement())
  bgpPeerId        String
  timestamp        DateTime @default(now())
  stateCode        Int
  state            BgpState
  established      Boolean
  receivedPrefixes BigInt?
  bgpPeer          BgpPeer  @relation(fields: [bgpPeerId], references: [id], onDelete: Cascade)

  @@index([bgpPeerId, timestamp])
}

model BgpPeerStateEvent {
  id                BigInt   @id @default(autoincrement())
  bgpPeerId         String
  previousStateCode Int
  previousState     BgpState
  currentStateCode  Int
  currentState      BgpState
  occurredAt        DateTime @default(now())
  bgpPeer           BgpPeer  @relation(fields: [bgpPeerId], references: [id], onDelete: Cascade)

  @@index([bgpPeerId, occurredAt])
}

/**
 * Perfil de mitigação DDoS de um cliente/policy BGP. É a unidade de operação do
 * motor: associa device → interface → policy → peers → banda. O modo padrão é
 * `ALERT_ONLY` (nenhum cliente novo entra em AUTO sozinho).
 * Nunca armazenamos credencial, token ou output SSH cru.
 */
model BgpMitigationProfile {
  id                   String                       @id @default(cuid())
  deviceId             String
  policyName           String
  /**
   * Alvo = device + interface + familia + policy (IPv4 e IPv6 nunca se misturam).
   */
  addressFamily        BgpAddressFamily             @default(IPV4)
  interfaceId          String
  detectedBandwidthBps BigInt?
  bandwidthSource      BgpMitigationBandwidthSource @default(UNKNOWN)
  bandwidthOverrideBps BigInt?
  prefixLimit          Int                          @default(100)
  mode                 BgpMitigationProfileMode     @default(ALERT_ONLY)
  enabled              Boolean                      @default(true)
  triggerPercent       Float                        @default(90)
  recoveryPercent      Float                        @default(70)
  triggerSamples       Int                          @default(3)
  recoverySamples      Int                          @default(12)
  checkIntervalSeconds Int                          @default(5)
  mitigationRt         String                       @default("268568:660")
  /**
   * Exclusao administrativa por TARGET/PEER ("nunca mitigar este peer").
   * Nao mexe em readiness: um target READY pode estar administrativamente
   * proibido. Bloqueia NOVO ACTIVATE; REMOVE de mitigacao ativa continua valendo.
   */
  mitigationExcluded        Boolean                      @default(false)
  mitigationExclusionReason BgpMitigationExclusionReason?
  mitigationExclusionNote   String?
  createdAt            DateTime                     @default(now())
  updatedAt            DateTime                     @updatedAt

  device      Device                     @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  interface   Interface                  @relation(fields: [interfaceId], references: [id], onDelete: Cascade)
  peers       BgpMitigationProfilePeer[]
  runtime     BgpMitigationRuntime?
  simulations BgpMitigationSimulation[]
  events      BgpMitigationEvent[]

  @@unique([deviceId, interfaceId, addressFamily, policyName])
  @@index([deviceId, mode])
  @@index([policyName, addressFamily])
  @@index([policyName])
  @@index([interfaceId])
}

model BgpMitigationProfilePeer {
  id            String           @id @default(cuid())
  profileId     String
  peerId        String?
  peerAddress   String
  addressFamily BgpAddressFamily @default(IPV4)
  primary       Boolean          @default(false)
  createdAt     DateTime         @default(now())

  profile BgpMitigationProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  peer    BgpPeer?             @relation(fields: [peerId], references: [id], onDelete: SetNull)

  @@unique([profileId, peerAddress])
  @@index([peerId])
  @@index([addressFamily])
}

/**
 * Estado de execução por perfil, separado do perfil para o worker reconstruir
 * o estado após restart/reconnect a partir do PostgreSQL — nunca da memória.
 */
model BgpMitigationRuntime {
  id                    String             @id @default(cuid())
  profileId             String             @unique
  state                 BgpMitigationState @default(NORMAL)
  currentTrafficBps     BigInt?
  peakTrafficBps        BigInt?
  triggerCounter        Int                @default(0)
  recoveryCounter       Int                @default(0)
  plannedNode           Int?
  plannedBogonNode      Int?
  plannedMitigationNode Int?
  lastSampleAt          DateTime?
  lastValidatedAt       DateTime?
  lastReconciledAt      DateTime?
  safeError             String?
  updatedAt             DateTime           @updatedAt

  profile BgpMitigationProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([state])
  @@index([lastSampleAt])
}

/**
 * Simulações executadas pelo operador. `commandPreview` guarda apenas o texto
 * dos comandos que SERIAM enviados (nunca são enviados nesta versão).
 */
model BgpMitigationSimulation {
  id                          String                        @id @default(cuid())
  profileId                   String
  userId                      String?
  simulatedTrafficBps         BigInt?
  simulatedUtilizationPercent Float?
  simulatedSamples            Int?
  simulatedPrefixCount        Int?
  calculatedThresholdBps      BigInt?
  result                      BgpMitigationSimulationResult
  plannedNode                 Int?
  plannedPolicy               String?
  plannedRt                   String?
  affectedPeers               Json?
  commandPreview              Json?
  notificationPublished       Boolean                       @default(false)
  createdAt                   DateTime                      @default(now())

  profile BgpMitigationProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  user    User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  events  BgpMitigationEvent[]

  @@index([profileId, createdAt])
  @@index([userId])
}

/**
 * Histórico auditável do motor: estado antes/depois, tráfego, threshold, node,
 * policy e o desfecho (com read-back/verificação). Sem output SSH bruto.
 */
model BgpMitigationEvent {
  id            BigInt              @id @default(autoincrement())
  profileId     String
  simulationId  String?
  type          String
  previousState BgpMitigationState?
  newState      BgpMitigationState?
  trafficBps    BigInt?
  thresholdBps  BigInt?
  plannedNode   Int?
  policyName    String?
  success       Boolean             @default(false)
  verified      Boolean             @default(false)
  safeError     String?
  createdAt     DateTime            @default(now())

  profile    BgpMitigationProfile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  simulation BgpMitigationSimulation? @relation(fields: [simulationId], references: [id], onDelete: SetNull)

  @@index([profileId, createdAt])
  @@index([simulationId])
}

model MplsDeviceState {
  id            String     @id @default(cuid())
  hostId        String     @unique
  supported     Boolean    @default(false)
  vsiSupported  Boolean    @default(false)
  acSupported   Boolean    @default(false)
  pwSupported   Boolean    @default(false)
  source        MplsSource @default(SNMP)
  lastPollingAt DateTime?
  lastSuccessAt DateTime?
  lastFailureAt DateTime?
  lastErrorSafe String?
  host          Device     @relation(fields: [hostId], references: [id], onDelete: Cascade)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model MplsVsi {
  id                String                   @id @default(cuid())
  hostId            String
  name              String
  signalingType     String                   @default("UNKNOWN")
  rd                String?
  vsiId             Int?
  status            MplsStatus               @default(UNKNOWN)
  operationalStatus MplsVsiOperationalStatus @default(UNKNOWN)
  adminStatus       MplsAdminStatus          @default(UNKNOWN)
  mtu               Int?
  vcType            String                   @default("UNKNOWN")
  tunnelPolicy      String?
  description       String?
  vlanId            Int?
  localInterfaceId  String?
  source            MplsSource               @default(SNMP)
  lastSeenAt        DateTime
  host              Device                   @relation(fields: [hostId], references: [id], onDelete: Cascade)
  localInterface    Interface?               @relation(fields: [localInterfaceId], references: [id], onDelete: SetNull)
  pws               MplsPw[]
  acs               MplsAc[]
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@unique([hostId, name])
  @@index([hostId])
  @@index([operationalStatus])
  @@index([status])
  @@index([lastSeenAt])
  @@index([localInterfaceId])
}

model MplsAc {
  id             String       @id @default(cuid())
  hostId         String
  mplsVsiId      String
  vsiName        String
  ifIndex        Int
  interfaceId    String?
  status         MplsAcStatus @default(UNKNOWN)
  upStartTimeRaw String?
  upSumTimeRaw   BigInt?
  source         MplsSource   @default(SNMP)
  lastSeenAt     DateTime
  host           Device       @relation(fields: [hostId], references: [id], onDelete: Cascade)
  vsi            MplsVsi      @relation(fields: [mplsVsiId], references: [id], onDelete: Cascade)
  interface      Interface?   @relation(fields: [interfaceId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([hostId, vsiName, ifIndex])
  @@index([hostId])
  @@index([mplsVsiId])
  @@index([interfaceId])
  @@index([lastSeenAt])
}

model MplsPw {
  id            String             @id @default(cuid())
  hostId        String
  mplsVsiId     String
  vsiName       String
  pwId          Int
  remoteIp      String
  remoteHostId  String?
  tunnelPolicy  String?
  pwType        String             @default("UNKNOWN")
  inboundLabel  Int?
  outboundLabel Int?
  status        MplsPwStatus       @default(UNKNOWN)
  state         MplsPwState        @default(UNKNOWN)
  workingState  MplsPwWorkingState @default(UNKNOWN)
  upStartTime   DateTime?
  upSumTime     BigInt?
  source        MplsSource         @default(SNMP)
  lastSeenAt    DateTime
  host          Device             @relation("MplsPwHost", fields: [hostId], references: [id], onDelete: Cascade)
  vsi           MplsVsi            @relation(fields: [mplsVsiId], references: [id], onDelete: Cascade)
  remoteHost    Device?            @relation("MplsPwRemoteHost", fields: [remoteHostId], references: [id], onDelete: SetNull)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([hostId, vsiName, pwId, remoteIp])
  @@index([hostId])
  @@index([mplsVsiId])
  @@index([remoteIp])
  @@index([remoteHostId])
  @@index([status])
  @@index([lastSeenAt])
}

model MplsStateEvent {
  id             BigInt         @id @default(autoincrement())
  hostId         String
  entityType     MplsEntityType
  entityId       String
  vsiName        String
  pwId           Int?
  remoteIp       String?
  previousStatus String
  currentStatus  String
  occurredAt     DateTime       @default(now())
  host           Device         @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@index([hostId, occurredAt])
  @@index([entityType, entityId, occurredAt])
}

model DeviceMetricSample {
  id            BigInt   @id @default(autoincrement())
  deviceId      String
  timestamp     DateTime @default(now())
  uptimeSeconds BigInt?
  sysName       String?
  sysDescr      String?
  sysObjectId   String?
  device        Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, timestamp])
}

model InterfaceMetricSample {
  id               BigInt          @id @default(autoincrement())
  interfaceId      String
  timestamp        DateTime        @default(now())
  inOctets         BigInt
  outOctets        BigInt
  rxBps            Float
  txBps            Float
  inErrors         BigInt          @default(0)
  outErrors        BigInt          @default(0)
  inDiscards       BigInt          @default(0)
  outDiscards      BigInt          @default(0)
  inErrorsDelta    BigInt          @default(0)
  outErrorsDelta   BigInt          @default(0)
  inDiscardsDelta  BigInt          @default(0)
  outDiscardsDelta BigInt          @default(0)
  operStatus       InterfaceStatus @default(UNKNOWN)
  interface        Interface       @relation(fields: [interfaceId], references: [id], onDelete: Cascade)

  @@index([interfaceId, timestamp])
}

model InterfaceOpticalSample {
  id           BigInt    @id @default(autoincrement())
  interfaceId  String
  timestamp    DateTime  @default(now())
  rxPowerDbm   Float?
  txPowerDbm   Float?
  opticalLanes Json?
  interface    Interface @relation(fields: [interfaceId], references: [id], onDelete: Cascade)

  @@index([interfaceId, timestamp])
}

model MapWidget {
  id        String   @id @default(cuid())
  mapId     String
  type      String
  positionX Float    @default(0)
  positionY Float    @default(0)
  enabled   Boolean  @default(true)
  settings  Json?
  map       Map      @relation(fields: [mapId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([mapId, type])
  @@index([mapId])
}

model Alarm {
  id             String        @id @default(cuid())
  deviceId       String
  interfaceId    String
  linkId         String?
  type           AlarmType     @default(INTERFACE_DOWN)
  severity       AlarmSeverity @default(CRITICAL)
  startedAt      DateTime      @default(now())
  endedAt        DateTime?
  acknowledgedAt DateTime?
  acknowledgedBy String?
  message        String
  device         Device        @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  interface      Interface     @relation(fields: [interfaceId], references: [id], onDelete: Cascade)
  link           Link?         @relation(fields: [linkId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([deviceId])
  @@index([interfaceId, endedAt])
  @@index([startedAt])
}

model Link {
  id                      String              @id @default(cuid())
  mapId                   String
  sourceDeviceId          String?
  sourceInterfaceId       String?
  targetDeviceId          String?
  targetInterfaceId       String?
  sourceNodeId            String?
  targetNodeId            String?
  capacityBps             BigInt
  autoCapacityBps         BigInt?
  capacitySource          CapacitySource      @default(AUTO)
  trafficMode             TrafficMode         @default(BIDIRECTIONAL)
  customColor             String?
  trafficColorAToB        String?
  trafficColorBToA        String?
  inlineLabelPositionAToB Float?
  inlineLabelPositionBToA Float?
  animationEnabled        Boolean?
  label                   String?
  status                  DeviceStatus        @default(UNKNOWN)
  discoverySource         DiscoverySource     @default(MANUAL)
  metricSource            String
  visualStyle             LinkDisplayStyle?
  metricDisplay           LinkMetricDisplay?
  aggregationMode         LinkAggregationMode @default(NONE)
  metricSources           Json?
  visualPaths             Json?
  linkLayoutMode          LinkLayoutMode      @default(AUTO)
  sourceHandleSide        LinkHandleSide      @default(AUTO)
  targetHandleSide        LinkHandleSide      @default(AUTO)
  map                     Map                 @relation(fields: [mapId], references: [id], onDelete: Cascade)
  sourceDevice            Device?             @relation("LinkSourceDevice", fields: [sourceDeviceId], references: [id], onDelete: Restrict)
  sourceInterface         Interface?          @relation("LinkSourceInterface", fields: [sourceInterfaceId], references: [id], onDelete: Restrict)
  targetDevice            Device?             @relation("LinkTargetDevice", fields: [targetDeviceId], references: [id], onDelete: Restrict)
  targetInterface         Interface?          @relation("LinkTargetInterface", fields: [targetInterfaceId], references: [id], onDelete: Restrict)
  sourceNode              MapNode?            @relation("LinkSourceNode", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode              MapNode?            @relation("LinkTargetNode", fields: [targetNodeId], references: [id], onDelete: Cascade)
  alarms                  Alarm[]
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  @@index([mapId])
  @@index([sourceDeviceId])
  @@index([targetDeviceId])
  @@index([sourceNodeId])
  @@index([targetNodeId])
}

model MapPlaylist {
  id                      String            @id @default(cuid())
  name                    String
  rotationIntervalSeconds Int               @default(60)
  isDefault               Boolean           @default(false)
  items                   MapPlaylistItem[]
  publicViews             PublicView[]
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
}

model MapPlaylistItem {
  playlistId String
  mapId      String
  order      Int
  playlist   MapPlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  map        Map         @relation(fields: [mapId], references: [id], onDelete: Cascade)

  @@id([playlistId, mapId])
  @@unique([playlistId, order])
  @@index([mapId])
}

model DataSource {
  id         String                   @id @default(cuid())
  name       String
  type       String
  baseUrl    String?
  enabled    Boolean                  @default(true)
  config     Json?
  secret     Bytes?
  mappings   DeviceSourceMapping[]
  interfaces InterfaceSourceMapping[]
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt
}

model SnmpCredential {
  id               String   @id @default(cuid())
  name             String
  version          String
  port             Int      @default(161)
  encryptedPayload Bytes
  devices          Device[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model SshCredential {
  id               String   @id @default(cuid())
  name             String
  port             Int      @default(22)
  username         String
  encryptedPayload Bytes
  devices          Device[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model DeviceSourceMapping {
  id           String      @id @default(cuid())
  deviceId     String
  dataSourceId String
  externalId   String
  matchStatus  MatchStatus @default(UNMATCHED)
  matchReason  String?
  device       Device      @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  dataSource   DataSource  @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)

  @@unique([dataSourceId, externalId])
}

model InterfaceSourceMapping {
  id           String     @id @default(cuid())
  interfaceId  String
  dataSourceId String
  externalId   String
  interface    Interface  @relation(fields: [interfaceId], references: [id], onDelete: Cascade)
  dataSource   DataSource @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)

  @@unique([dataSourceId, externalId])
}

model DeviceSourceHealth {
  id            String                @id @default(cuid())
  deviceId      String
  source        SourceKind
  state         SourceConnectionState @default(CONFIGURED)
  lastSuccess   DateTime?
  lastFailure   DateTime?
  lastErrorSafe String?
  device        Device                @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@unique([deviceId, source])
  @@index([source, state])
}

model DiscoveryJob {
  id        String             @id @default(cuid())
  deviceId  String
  method    String
  status    DiscoveryJobStatus @default(PENDING)
  error     String?
  device    Device             @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  results   DiscoveryResult[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model DiscoveryResult {
  id              String       @id @default(cuid())
  jobId           String
  localPort       String
  remotePort      String
  remoteIdentity  Json
  matchStatus     MatchStatus  @default(UNMATCHED)
  matchedDeviceId String?
  accepted        Boolean      @default(false)
  job             DiscoveryJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())
}

model LldpTopologyPreview {
  id        String   @id
  mapId     String
  payload   Json
  createdAt DateTime @default(now())

  @@index([mapId])
}

model User {
  id                    String                    @id @default(cuid())
  username              String                    @unique
  email                 String                    @unique
  passwordHash          String
  name                  String
  role                  Role                      @default(VIEWER)
  enabled               Boolean                   @default(true)
  sessions              Session[]
  mitigationSimulations BgpMitigationSimulation[]
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model PublicView {
  id         String         @id @default(cuid())
  token      String         @unique
  name       String
  type       PublicViewType
  mapId      String?
  playlistId String?
  enabled    Boolean        @default(true)
  expiresAt  DateTime?
  map        Map?           @relation(fields: [mapId], references: [id], onDelete: Cascade)
  playlist   MapPlaylist?   @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  @@index([mapId])
  @@index([playlistId])
}

model PhysicalSite {
  id          String         @id @default(cuid())
  name        String
  code        String?        @unique
  description String         @default("")
  racks       PhysicalRack[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([name])
}

model PhysicalRack {
  id          String          @id @default(cuid())
  siteId      String
  name        String
  units       Int             @default(42)
  description String          @default("")
  site        PhysicalSite    @relation(fields: [siteId], references: [id], onDelete: Restrict)
  assets      PhysicalAsset[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([siteId, name])
  @@index([siteId])
}

model PhysicalEquipmentTemplate {
  id                 String                   @id @default(cuid())
  name               String                   @unique
  /**
   * Stable catalog identity (slug); never duplicated on bootstrap.
   */
  catalogKey         String?                  @unique
  category           String                   @default("")
  manufacturer       String                   @default("")
  family             String                   @default("")
  model              String                   @default("")
  kind               PhysicalAssetKind        @default(GENERIC)
  heightU            Int                      @default(1)
  description        String                   @default("")
  /**
   * True only when the structure was confirmed against vendor documentation.
   */
  vendorVerified     Boolean                  @default(false)
  /**
   * False keeps slots/ports open for manual completion instead of inventing them.
   */
  structureConfirmed Boolean                  @default(false)
  referenceUrl       String?
  origin             PhysicalTemplateOrigin   @default(CUSTOM)
  ports              PhysicalTemplatePort[]
  slots              PhysicalTemplateSlot[]
  modules            PhysicalModuleTemplate[]
  assets             PhysicalAsset[]
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  @@index([category])
  @@index([manufacturer])
  @@index([origin])
}

/**
 * Bays of a modular chassis template (NE8000, MA5800, ...).
 */
model PhysicalTemplateSlot {
  id            String                       @id @default(cuid())
  templateId    String
  index         Int
  label         String                       @default("")
  description   String                       @default("")
  template      PhysicalEquipmentTemplate    @relation(fields: [templateId], references: [id], onDelete: Cascade)
  moduleOptions PhysicalTemplateSlotModule[]
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt

  @@unique([templateId, index])
  @@index([templateId])
}

/**
 * Which module templates may be installed in a slot.
 */
model PhysicalTemplateSlotModule {
  id               String                 @id @default(cuid())
  slotId           String
  moduleTemplateId String
  isDefault        Boolean                @default(false)
  slot             PhysicalTemplateSlot   @relation(fields: [slotId], references: [id], onDelete: Cascade)
  moduleTemplate   PhysicalModuleTemplate @relation(fields: [moduleTemplateId], references: [id], onDelete: Cascade)

  @@unique([slotId, moduleTemplateId])
  @@index([moduleTemplateId])
}

/**
 * Installable board (LPU/GPON/uplink) with its own ports.
 */
model PhysicalModuleTemplate {
  id            String                       @id @default(cuid())
  templateId    String
  catalogKey    String?
  name          String
  model         String                       @default("")
  description   String                       @default("")
  slotsRequired Int                          @default(1)
  template      PhysicalEquipmentTemplate    @relation(fields: [templateId], references: [id], onDelete: Cascade)
  ports         PhysicalModuleTemplatePort[]
  slotOptions   PhysicalTemplateSlotModule[]
  modules       PhysicalModule[]
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime                     @updatedAt

  @@unique([templateId, name])
  @@index([templateId])
}

model PhysicalModuleTemplatePort {
  id               String                 @id @default(cuid())
  moduleTemplateId String
  name             String
  label            String                 @default("")
  sortOrder        Int
  type             PhysicalPortType       @default(OTHER)
  moduleTemplate   PhysicalModuleTemplate @relation(fields: [moduleTemplateId], references: [id], onDelete: Cascade)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@unique([moduleTemplateId, name])
  @@unique([moduleTemplateId, sortOrder])
  @@index([moduleTemplateId])
}

model PhysicalTemplatePort {
  id                   String                    @id @default(cuid())
  templateId           String
  name                 String
  label                String                    @default("")
  sortOrder            Int
  side                 PhysicalPortSide          @default(DEVICE)
  type                 PhysicalPortType          @default(OTHER)
  pairedTemplatePortId String?                   @unique
  template             PhysicalEquipmentTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  pairedTemplatePort   PhysicalTemplatePort?     @relation("PhysicalTemplatePortPair", fields: [pairedTemplatePortId], references: [id], onDelete: SetNull)
  pairedBy             PhysicalTemplatePort?     @relation("PhysicalTemplatePortPair")
  physicalPorts        PhysicalPort[]

  @@unique([templateId, side, name])
  @@unique([templateId, side, sortOrder])
  @@index([templateId])
}

model PhysicalAsset {
  id          String                     @id @default(cuid())
  rackId      String
  deviceId    String?                    @unique
  templateId  String?
  name        String
  kind        PhysicalAssetKind          @default(GENERIC)
  startU      Int
  heightU     Int                        @default(1)
  description String                     @default("")
  rack        PhysicalRack               @relation(fields: [rackId], references: [id], onDelete: Restrict)
  device      Device?                    @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  template    PhysicalEquipmentTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  ports       PhysicalPort[]
  slots       PhysicalSlot[]
  modules     PhysicalModule[]
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt

  @@unique([rackId, name])
  @@index([rackId, startU])
  @@index([templateId])
}

/**
 * Materialized bay of a chassis asset.
 */
model PhysicalSlot {
  id        String          @id @default(cuid())
  assetId   String
  index     Int
  label     String          @default("")
  asset     PhysicalAsset   @relation(fields: [assetId], references: [id], onDelete: Cascade)
  module    PhysicalModule?
  ports     PhysicalPort[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([assetId, index])
  @@index([assetId])
}

/**
 * Board installed in a slot; its ports belong to the asset and the slot.
 */
model PhysicalModule {
  id               String                  @id @default(cuid())
  assetId          String
  slotId           String                  @unique
  moduleTemplateId String?
  name             String
  model            String                  @default("")
  serial           String                  @default("")
  asset            PhysicalAsset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  slot             PhysicalSlot            @relation(fields: [slotId], references: [id], onDelete: Cascade)
  moduleTemplate   PhysicalModuleTemplate? @relation(fields: [moduleTemplateId], references: [id], onDelete: SetNull)
  ports            PhysicalPort[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([assetId])
  @@index([moduleTemplateId])
}

/**
 * Snapshot of the latest LLDP adjacency seen by the existing discovery engine.
 * Read-only for the physical view: it never creates a PhysicalConnection alone.
 */
model PhysicalLldpAdjacency {
  id                String   @id @default(cuid())
  localDeviceId     String
  localInterfaceId  String?
  localPortName     String
  remoteDeviceId    String?
  remoteHostname    String
  remotePortName    String
  remoteInterfaceId String?
  remoteChassisId   String?
  confidence        String
  /**
   * True only when both endpoints resolved to a known inventory object.
   */
  resolved          Boolean  @default(false)
  ambiguous         Boolean  @default(false)
  source            String
  observedAt        DateTime
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([localDeviceId, localPortName, remoteHostname, remotePortName])
  @@index([localInterfaceId])
  @@index([remoteDeviceId])
  @@index([observedAt])
}

model PhysicalPort {
  id                String                 @id @default(cuid())
  assetId           String
  templatePortId    String?
  slotId            String?
  moduleId          String?
  mappedInterfaceId String?                @unique
  connectionId      String?
  connectionEnd     PhysicalConnectionEnd?
  pairedPortId      String?                @unique
  name              String
  label             String                 @default("")
  sortOrder         Int
  side              PhysicalPortSide       @default(DEVICE)
  type              PhysicalPortType       @default(OTHER)
  role              PhysicalPortRole       @default(TEMPLATE)
  notes             String                 @default("")
  asset             PhysicalAsset          @relation(fields: [assetId], references: [id], onDelete: Cascade)
  templatePort      PhysicalTemplatePort?  @relation(fields: [templatePortId], references: [id], onDelete: SetNull)
  slot              PhysicalSlot?          @relation(fields: [slotId], references: [id], onDelete: SetNull)
  module            PhysicalModule?        @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  mappedInterface   Interface?             @relation(fields: [mappedInterfaceId], references: [id], onDelete: SetNull)
  connection        PhysicalConnection?    @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  pairedPort        PhysicalPort?          @relation("PhysicalPortPair", fields: [pairedPortId], references: [id], onDelete: SetNull)
  pairedBy          PhysicalPort?          @relation("PhysicalPortPair")
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@unique([assetId, side, name])
  @@unique([assetId, side, sortOrder])
  @@unique([connectionId, connectionEnd])
  @@index([assetId])
  @@index([connectionId])
  @@index([templatePortId])
  @@index([slotId])
  @@index([moduleId])
}

model PhysicalConnection {
  id           String                   @id @default(cuid())
  medium       PhysicalConnectionMedium @default(UNKNOWN)
  label        String                   @default("")
  notes        String                   @default("")
  lengthMeters Float?
  ports        PhysicalPort[]
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt
}

enum MediaIntegrationType {
  WEBHOOK
}

enum MediaIntegrationPurpose {
  BGP_MITIGATION
}

enum MediaDeliveryDirection {
  OUTBOUND
  INBOUND
}

enum MediaDeliveryStatus {
  SUCCESS
  FAILED
  SKIPPED
}

/// Integracao de midia (notificacao). Generica de proposito: o NetVision nao
/// modela "Telegram" - o transporte externo continua responsabilidade do n8n.
model MediaIntegration {
  id                      String                  @id @default(cuid())
  name                    String
  type                    MediaIntegrationType    @default(WEBHOOK)
  purpose                 MediaIntegrationPurpose
  enabled                 Boolean                 @default(true)
  outboundUrl             String?
  outboundSecretEncrypted Bytes?
  inboundEnabled          Boolean                 @default(false)
  inboundSecretEncrypted  Bytes?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  lastOutboundAttemptAt   DateTime?
  lastOutboundSuccessAt   DateTime?
  lastOutboundFailureAt   DateTime?
  lastOutboundStatusCode  Int?
  lastOutboundLatencyMs   Int?
  lastOutboundEvent       String?
  lastOutboundErrorSafe   String?
  lastInboundAt           DateTime?
  lastInboundAction       String?
  lastInboundStatus       String?
  lastInboundRequestId    String?
  lastInboundErrorSafe    String?
  logs                    MediaDeliveryLog[]

  @@unique([type, purpose])
  @@index([purpose, enabled])
}

/// Log operacional das entregas. NUNCA guarda payload completo nem segredo:
/// apenas metadados seguros (status HTTP, duracao, erro seguro, origem).
model MediaDeliveryLog {
  id                 String                 @id @default(cuid())
  mediaIntegrationId String?
  direction          MediaDeliveryDirection
  event              String?
  action             String?
  profileId          String?
  requestId          String?
  status             MediaDeliveryStatus
  httpStatus         Int?
  latencyMs          Int?
  idempotent         Boolean?
  safeError          String?
  destination        String?
  createdAt          DateTime               @default(now())
  mediaIntegration   MediaIntegration?      @relation(fields: [mediaIntegrationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([mediaIntegrationId, createdAt])
  @@index([direction, createdAt])
  @@index([profileId, createdAt])
}
