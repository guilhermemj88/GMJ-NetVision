generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MapMode {
  MANUAL
  AUTO
  HYBRID
}

enum PositionSource {
  AUTO
  MANUAL
}

enum NodeDisplayMode {
  ICON_2D
  ICON_3D
  CARD
}

enum LinkDisplayStyle {
  FLOW
  WEATHERMAP
  HYBRID
  MINIMAL
}

enum LinkMetricDisplay {
  THROUGHPUT
  UTILIZATION
  BOTH
  NONE
}

enum CapacitySource {
  AUTO
  MANUAL
}

enum DeviceStatus {
  UP
  DOWN
  WARNING
  UNKNOWN
}

enum InterfaceStatus {
  UP
  DOWN
  DISABLED
  WARNING
  UNKNOWN
}

enum DiscoverySource {
  MANUAL
  LLDP_SNMP
  LLDP_SSH
}

enum DiscoveryJobStatus {
  PENDING
  RUNNING
  REVIEW
  COMPLETED
  FAILED
}

enum MatchStatus {
  MATCHED
  UNMATCHED
  AMBIGUOUS
}

enum HostOrigin {
  MANUAL
  ZABBIX
  DISCOVERY
  IMPORTED
}

enum SourceKind {
  ZABBIX
  SSH
  SNMP
}

enum SourceConnectionState {
  DISABLED
  CONFIGURED
  CONNECTED
  FAILED
}

enum SnmpVersion {
  SNMP_V2C
  SNMP_V3
}

enum SnmpSecurityLevel {
  NO_AUTH_NO_PRIV
  AUTH_NO_PRIV
  AUTH_PRIV
}

enum SnmpAuthProtocol {
  MD5
  SHA
  SHA256
}

enum SnmpPrivacyProtocol {
  DES
  AES
  AES256
}

model Map {
  id                String            @id @default(cuid())
  name              String
  description       String            @default("")
  mode              MapMode           @default(HYBRID)
  isDefault         Boolean           @default(false)
  nodeDisplayMode   NodeDisplayMode   @default(ICON_2D)
  linkDisplayStyle  LinkDisplayStyle  @default(HYBRID)
  linkMetricDisplay LinkMetricDisplay @default(BOTH)
  nodeScale         Float             @default(100)
  linkScale         Float             @default(100)
  labelScale        Float             @default(100)
  viewport          Json?
  filters           Json?
  nodes             MapNode[]
  links             Link[]
  playlistItems     MapPlaylistItem[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model MapNode {
  id             String         @id @default(cuid())
  mapId          String
  deviceId       String
  x              Float
  y              Float
  locked         Boolean        @default(false)
  positionSource PositionSource @default(AUTO)
  map            Map            @relation(fields: [mapId], references: [id], onDelete: Cascade)
  device         Device         @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@unique([mapId, deviceId])
  @@index([deviceId])
}

model Device {
  id                  String                @id @default(cuid())
  name                String
  displayName         String
  hostname            String
  ip                  String
  managementIp        String
  vendor              String?
  model               String?
  description         String                @default("")
  notes               String                @default("")
  origin              HostOrigin            @default(MANUAL)
  status              DeviceStatus          @default(UNKNOWN)
  deviceType          String
  site                String?
  source              String
  discoveryMethod     String                @default("AUTO")
  useZabbix           Boolean               @default(false)
  zabbixHostId        String?
  zabbixHostName      String?
  zabbixInterfaceId   String?
  zabbixIp            String?
  sshEnabled          Boolean               @default(false)
  sshHost             String?
  sshPort             Int                   @default(22)
  sshUsername         String?
  sshAuthentication   String?
  snmpEnabled         Boolean               @default(false)
  snmpVersion         SnmpVersion?
  snmpHost            String?
  snmpPort            Int                   @default(161)
  snmpUsername        String?
  snmpSecurityLevel   SnmpSecurityLevel?
  snmpAuthProtocol    SnmpAuthProtocol?
  snmpPrivacyProtocol SnmpPrivacyProtocol?
  lastPollingAt       DateTime?
  lastDiscoveryAt     DateTime?
  uptimeSeconds       BigInt?
  cpuPercent          Float?
  memoryPercent       Float?
  interfaces          Interface[]
  metricSamples       DeviceMetricSample[]
  mapNodes            MapNode[]
  sourceLinks         Link[]                @relation("LinkSourceDevice")
  targetLinks         Link[]                @relation("LinkTargetDevice")
  sourceMappings      DeviceSourceMapping[]
  discoveryJobs       DiscoveryJob[]
  sourceHealth        DeviceSourceHealth[]
  snmpCredentialId    String?
  sshCredentialId     String?
  snmpCredential      SnmpCredential?        @relation(fields: [snmpCredentialId], references: [id])
  sshCredential       SshCredential?         @relation(fields: [sshCredentialId], references: [id])
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@index([hostname])
  @@index([ip])
  @@index([managementIp])
  @@index([zabbixHostId])
}

model Interface {
  id                String                   @id @default(cuid())
  deviceId          String
  name              String
  alias             String?
  description       String?
  ifIndex           Int
  mac               String?
  mtu               Int?
  speedBps          BigInt?
  adminStatus       String
  operStatus        InterfaceStatus          @default(UNKNOWN)
  rxPowerDbm        Float?
  txPowerDbm        Float?
  opticalSource     String?
  opticalUpdatedAt  DateTime?
  rxItemId          String?
  txItemId          String?
  statusItemId      String?
  inErrorsItemId    String?
  outErrorsItemId   String?
  inDiscardsItemId  String?
  outDiscardsItemId String?
  dataSources       Json?
  device            Device                   @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  metricSamples     InterfaceMetricSample[]
  sourceLinks       Link[]                   @relation("LinkSourceInterface")
  targetLinks       Link[]                   @relation("LinkTargetInterface")
  sourceMappings    InterfaceSourceMapping[]
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt

  @@unique([deviceId, ifIndex])
}

model DeviceMetricSample {
  id            BigInt   @id @default(autoincrement())
  deviceId      String
  timestamp     DateTime @default(now())
  uptimeSeconds BigInt?
  sysName       String?
  sysDescr      String?
  sysObjectId   String?
  device        Device   @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, timestamp])
}

model InterfaceMetricSample {
  id          BigInt          @id @default(autoincrement())
  interfaceId String
  timestamp   DateTime        @default(now())
  inOctets    BigInt
  outOctets   BigInt
  rxBps       Float
  txBps       Float
  inErrors    BigInt          @default(0)
  outErrors   BigInt          @default(0)
  inDiscards  BigInt          @default(0)
  outDiscards BigInt          @default(0)
  inErrorsDelta    BigInt      @default(0)
  outErrorsDelta   BigInt      @default(0)
  inDiscardsDelta  BigInt      @default(0)
  outDiscardsDelta BigInt      @default(0)
  operStatus  InterfaceStatus @default(UNKNOWN)
  interface   Interface       @relation(fields: [interfaceId], references: [id], onDelete: Cascade)

  @@index([interfaceId, timestamp])
}

model Link {
  id                String             @id @default(cuid())
  mapId             String
  sourceDeviceId    String
  sourceInterfaceId String
  targetDeviceId    String
  targetInterfaceId String
  capacityBps       BigInt
  autoCapacityBps   BigInt?
  capacitySource    CapacitySource     @default(AUTO)
  label             String?
  status            DeviceStatus       @default(UNKNOWN)
  discoverySource   DiscoverySource    @default(MANUAL)
  metricSource      String
  visualStyle       LinkDisplayStyle?
  metricDisplay     LinkMetricDisplay?
  map               Map                @relation(fields: [mapId], references: [id], onDelete: Cascade)
  sourceDevice      Device             @relation("LinkSourceDevice", fields: [sourceDeviceId], references: [id])
  sourceInterface   Interface          @relation("LinkSourceInterface", fields: [sourceInterfaceId], references: [id])
  targetDevice      Device             @relation("LinkTargetDevice", fields: [targetDeviceId], references: [id])
  targetInterface   Interface          @relation("LinkTargetInterface", fields: [targetInterfaceId], references: [id])
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([mapId])
  @@index([sourceDeviceId])
  @@index([targetDeviceId])
}

model MapPlaylist {
  id                      String            @id @default(cuid())
  name                    String
  rotationIntervalSeconds Int               @default(60)
  isDefault               Boolean           @default(false)
  items                   MapPlaylistItem[]
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
}

model MapPlaylistItem {
  playlistId String
  mapId      String
  order      Int
  playlist   MapPlaylist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  map        Map         @relation(fields: [mapId], references: [id], onDelete: Cascade)

  @@id([playlistId, mapId])
  @@unique([playlistId, order])
  @@index([mapId])
}

model DataSource {
  id         String                   @id @default(cuid())
  name       String
  type       String
  baseUrl    String?
  enabled    Boolean                  @default(true)
  config     Json?
  secret     Bytes?
  mappings   DeviceSourceMapping[]
  interfaces InterfaceSourceMapping[]
  createdAt  DateTime                 @default(now())
  updatedAt  DateTime                 @updatedAt
}

model SnmpCredential {
  id               String   @id @default(cuid())
  name             String
  version          String
  port             Int      @default(161)
  encryptedPayload Bytes
  devices          Device[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model SshCredential {
  id               String   @id @default(cuid())
  name             String
  port             Int      @default(22)
  username         String
  encryptedPayload Bytes
  devices          Device[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model DeviceSourceMapping {
  id           String      @id @default(cuid())
  deviceId     String
  dataSourceId String
  externalId   String
  matchStatus  MatchStatus @default(UNMATCHED)
  matchReason  String?
  device       Device      @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  dataSource   DataSource  @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)

  @@unique([dataSourceId, externalId])
}

model InterfaceSourceMapping {
  id           String     @id @default(cuid())
  interfaceId  String
  dataSourceId String
  externalId   String
  interface    Interface  @relation(fields: [interfaceId], references: [id], onDelete: Cascade)
  dataSource   DataSource @relation(fields: [dataSourceId], references: [id], onDelete: Cascade)

  @@unique([dataSourceId, externalId])
}

model DeviceSourceHealth {
  id            String                @id @default(cuid())
  deviceId      String
  source        SourceKind
  state         SourceConnectionState @default(CONFIGURED)
  lastSuccess   DateTime?
  lastFailure   DateTime?
  lastErrorSafe String?
  device        Device                @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@unique([deviceId, source])
  @@index([source, state])
}

model DiscoveryJob {
  id        String             @id @default(cuid())
  deviceId  String
  method    String
  status    DiscoveryJobStatus @default(PENDING)
  error     String?
  device    Device             @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  results   DiscoveryResult[]
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

model DiscoveryResult {
  id              String       @id @default(cuid())
  jobId           String
  localPort       String
  remotePort      String
  remoteIdentity  Json
  matchStatus     MatchStatus  @default(UNMATCHED)
  matchedDeviceId String?
  accepted        Boolean      @default(false)
  job             DiscoveryJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())
}

model LldpTopologyPreview {
  id        String   @id
  mapId     String
  payload   Json
  createdAt DateTime @default(now())

  @@index([mapId])
}
