# PROPOSTA. Nao instalar sem autorizacao explicita de publicacao/restart.
# Nome deve ordenar apos todos os drop-ins existentes. Conferir EnvironmentFiles.
[Service]
WorkingDirectory=/opt/netvision-auto-activate/releases/REPLACE_WITH_AUDITED_SHA/apps/api
ExecStart=
ExecStart=/usr/bin/node /opt/netvision-auto-activate/releases/REPLACE_WITH_AUDITED_SHA/apps/api/dist/server.cjs
EnvironmentFile=/etc/netvision/auto-activate-manual-remove-stage0.env
