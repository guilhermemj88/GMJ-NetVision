{
  "name": "NetVision - Retirada em policy compartilhada (solicitar)",
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "profileId"
            },
            {
              "name": "requestedBy"
            },
            {
              "name": "chatId"
            },
            {
              "name": "messageThreadId"
            }
          ]
        }
      },
      "id": "a1000000-0000-4000-8000-000000000001",
      "name": "Entrada (perfil + chat)",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.NETVISION_API_BASE }}/api/integrations/n8n/mitigation-command",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.NETVISION_N8N_COMMAND_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ requestId: 'telegram-' + $execution.id + '-' + Date.now(), action: 'REMOVE', profileId: $json.profileId, chatId: $json.chatId ? String($json.chatId) : undefined, ...($json.requestedBy ? { confirmedBy: 'telegram:' + $json.requestedBy } : {}) }) }}",
        "options": {
          "timeout": 60000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "a1000000-0000-4000-8000-000000000002",
      "name": "API: solicitar REMOVE (sem token)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cond-api-ok",
              "leftValue": "={{ $json.error === undefined || $json.error === null }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000003",
      "name": "API respondeu?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        480,
        0
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $('Entrada (perfil + chat)').first().json.chatId }}",
        "text": "=⚠️ Falha ao contatar a API de mitigação. Nenhuma alteração foi feita no equipamento. Tente novamente em instantes.",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "id": "a1000000-0000-4000-8000-000000000004",
      "name": "Telegram: falha de API",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        720,
        200
      ],
      "credentials": {
        "telegramApi": {
          "id": "SUBSTITUIR_CREDENTIAL_ID",
          "name": "Telegram NetVision"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cond-scope",
              "leftValue": "={{ $json.scopeConfirmation?.token }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000005",
      "name": "Precisa confirmar escopo?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        720,
        -100
      ]
    },
    {
      "parameters": {
        "jsCode": "// Mensagem com quebras de linha REAIS: o Telegram nao interpreta a sequencia \\n literal.\nconst api = $input.first().json;\nconst entrada = $('Entrada (perfil + chat)').first().json;\nconst affected = (api.removalScope && api.removalScope.affected) || [];\nconst peers = api.affectedPeers || [];\nconst linhas = [\n  '\\u26A0\\uFE0F RETIRADA DE MITIGA\\u00C7\\u00C3O \\u2014 POLICY COMPARTILHADA',\n  'Equipamento: ' + api.device,\n  'Policy: ' + api.policy + ' \\u2022 RT ' + api.rt + ' \\u2022 nodes ' + api.bogonNode + '/' + api.mitigationNode,\n  '',\n  'A retirada atinge TODOS os v\\u00EDnculos desta policy:',\n  '',\n  '\\u2022 ' + api.interface + ' \\u2014 ' + (api.customer || 'sem cliente') + ' \\u2014 peer ' + (peers[0] || '-') + ' (origem da solicita\\u00E7\\u00E3o)',\n];\nfor (const item of affected) {\n  linhas.push('\\u2022 ' + (item.interfaceName || item.profileId) + ' \\u2014 ' + (item.customer || 'sem cliente') + ' \\u2014 peer ' + (item.peerAddress || '-') + ' (' + item.runtimeState + ')');\n}\nlinhas.push('');\nlinhas.push('Solicitado por: ' + (entrada.requestedBy || 'operador') + '.');\nlinhas.push('Confirma\\u00E7\\u00E3o v\\u00E1lida at\\u00E9 ' + api.scopeConfirmation.expiresAt + '.');\nlinhas.push('');\nlinhas.push('Status: ' + api.status + (api.safeError && api.status !== 'SCOPE_CONFIRMATION_REQUIRED' ? ' \\u2014 ' + api.safeError : ''));\nreturn [{ json: { chatId: entrada.chatId, token: api.scopeConfirmation.token, text: linhas.join('\\n') } }];"
      },
      "id": "a1000000-0000-4000-8000-000000000006",
      "name": "Montar mensagem de confirmação",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        -100
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $json.chatId }}",
        "text": "={{ $json.text }}",
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": {
          "rows": [
            {
              "row": {
                "buttons": [
                  {
                    "text": "CANCELAR",
                    "additionalFields": {
                      "callback_data": "=rmc:{{ $json.token }}"
                    }
                  },
                  {
                    "text": "CONFIRMAR RETIRADA DE TODOS",
                    "additionalFields": {
                      "callback_data": "=rmx:{{ $json.token }}"
                    }
                  }
                ]
              }
            }
          ]
        },
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "id": "a1000000-0000-4000-8000-000000000007",
      "name": "Telegram: pedir confirmação do escopo",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1200,
        -100
      ],
      "credentials": {
        "telegramApi": {
          "id": "SUBSTITUIR_CREDENTIAL_ID",
          "name": "Telegram NetVision"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "b1",
              "name": "outcome",
              "value": "confirmation_required",
              "type": "string"
            },
            {
              "id": "b2",
              "name": "status",
              "value": "={{ $('API: solicitar REMOVE (sem token)').first().json.status }}",
              "type": "string"
            },
            {
              "id": "b3",
              "name": "expiresAt",
              "value": "={{ $('API: solicitar REMOVE (sem token)').first().json.scopeConfirmation.expiresAt }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000008",
      "name": "Saída: aguardando confirmação",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        1440,
        -100
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "c1",
              "name": "outcome",
              "value": "={{ $json.ok ? 'removed' : 'blocked' }}",
              "type": "string"
            },
            {
              "id": "c2",
              "name": "status",
              "value": "={{ $json.status }}",
              "type": "string"
            },
            {
              "id": "c3",
              "name": "verified",
              "value": "={{ $json.verified }}",
              "type": "boolean"
            },
            {
              "id": "c4",
              "name": "summary",
              "value": "={{ $json.verified ? 'Retirada verificada por read-back.' : ($json.safeError || 'Retirada não confirmada.') }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "a1000000-0000-4000-8000-000000000009",
      "name": "Saída: execução direta",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        960,
        100
      ]
    }
  ],
  "connections": {
    "Entrada (perfil + chat)": {
      "main": [
        [
          {
            "node": "API: solicitar REMOVE (sem token)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "API: solicitar REMOVE (sem token)": {
