      "main": [
        [
          {
            "node": "Cancelar?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Cancelar?": {
      "main": [
        [
          {
            "node": "Telegram: confirmar cancelamento",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "API: REMOVE com token de escopo",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "API: REMOVE com token de escopo": {
      "main": [
        [
          {
            "node": "Telegram: responder callback",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Telegram: responder callback": {
      "main": [
        [
          {
            "node": "Montar resultado",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Montar resultado": {
      "main": [
        [
          {
            "node": "Nova confirmação emitida?",
