{
  "name": "NetVision - Retirada em policy compartilhada (confirmar/cancelar)",
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "callbackData"
            },
            {
              "name": "fromId"
            },
            {
              "name": "chatId"
            },
            {
              "name": "messageId"
            },
            {
              "name": "callbackQueryId"
            }
          ]
        }
      },
      "id": "b1000000-0000-4000-8000-000000000001",
      "name": "Entrada (callback do Telegram)",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cond-callback",
              "leftValue": "={{ $json.callbackData }}",
              "rightValue": "^(rmx|rmc):[A-Za-z0-9_-]{16,128}$",
              "operator": {
                "type": "string",
                "operation": "regex"
              }
            },
            {
              "id": "cond-operator",
              "leftValue": "={{ ($env.NETVISION_TELEGRAM_OPERATORS || '').split(',').map(v => v.trim()).filter(v => v.length > 0).includes(String($json.fromId)) }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b1000000-0000-4000-8000-000000000002",
      "name": "Callback e operador válidos?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        240,
        0
      ]
    },
    {
      "parameters": {
        "callbackQueryId": "={{ $json.callbackQueryId }}",
        "text": "Ação não permitida para este operador.",
        "additionalFields": {
          "show_alert": true
        }
      },
      "id": "b1000000-0000-4000-8000-000000000003",
      "name": "Telegram: recusar operador",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        480,
        200
      ],
      "credentials": {
        "telegramApi": {
          "id": "SUBSTITUIR_CREDENTIAL_ID",
          "name": "Telegram NetVision"
        }
      }
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "d1",
              "name": "mode",
              "value": "={{ $json.callbackData.startsWith('rmx:') ? 'confirm' : 'cancel' }}",
              "type": "string"
            },
            {
              "id": "d2",
              "name": "token",
              "value": "={{ $json.callbackData.slice(4) }}",
              "type": "string"
            },
            {
              "id": "d3",
              "name": "fromId",
              "value": "={{ $json.fromId }}",
              "type": "string"
            },
            {
              "id": "d4",
              "name": "chatId",
              "value": "={{ $json.chatId }}",
              "type": "string"
            },
            {
              "id": "d5",
              "name": "messageId",
              "value": "={{ $json.messageId }}",
              "type": "number"
            },
            {
              "id": "d6",
              "name": "callbackQueryId",
              "value": "={{ $json.callbackQueryId }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "b1000000-0000-4000-8000-000000000004",
      "name": "Interpretar callback",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        480,
        -100
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cond-cancel",
              "leftValue": "={{ $json.mode }}",
              "rightValue": "cancel",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b1000000-0000-4000-8000-000000000005",
      "name": "Cancelar?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        720,
        -100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.NETVISION_API_BASE }}/api/integrations/n8n/mitigation-command",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.NETVISION_N8N_COMMAND_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ requestId: 'telegram-confirm-' + $execution.id + '-' + Date.now(), action: 'REMOVE', scopeConfirmationToken: $json.token, confirmedBy: 'telegram:' + $json.fromId, chatId: $json.chatId ? String($json.chatId) : undefined }) }}",
        "options": {
          "timeout": 90000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "id": "b1000000-0000-4000-8000-000000000006",
      "name": "API: REMOVE com token de escopo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        960,
        -200
      ],
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "callbackQueryId": "={{ $('Interpretar callback').first().json.callbackQueryId }}",
        "text": "={{ $('API: REMOVE com token de escopo').first().json.ok ? 'Retirada confirmada pela API.' : 'N\\u00E3o foi poss\\u00EDvel confirmar: ' + ($('API: REMOVE com token de escopo').first().json.status || 'API indispon\\u00EDvel') }}",
        "additionalFields": {
          "show_alert": false
        }
      },
      "id": "b1000000-0000-4000-8000-000000000007",
      "name": "Telegram: responder callback",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1200,
        -200
      ],
      "credentials": {
        "telegramApi": {
          "id": "SUBSTITUIR_CREDENTIAL_ID",
          "name": "Telegram NetVision"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Texto com quebras de linha REAIS e lista atualizada quando a API reemite o token.\nconst api = $('API: REMOVE com token de escopo').first().json;\nconst pedido = $('Interpretar callback').first().json;\nconst falhaDeTransporte = api.error !== undefined && api.error !== null;\nconst ok = !falhaDeTransporte && api.ok === true && api.verified === true;\nconst status = falhaDeTransporte ? 'API_INDISPONIVEL' : api.status;\nconst linhas = [];\nif (ok) {\n  linhas.push('\\u2705 RETIRADA DE TODOS CONCLU\\u00CDDA');\n  linhas.push('Policy: ' + api.policy + ' \\u2022 RT ' + api.rt);\n  linhas.push('Nodes removidos: ' + api.bogonNode + '/' + api.mitigationNode);\n  linhas.push('Read-back: ' + (((api.verification || {}).summary) || 'verificado'));\n  linhas.push('Confirmado por: telegram:' + pedido.fromId);\n} else {\n  linhas.push('\\u26A0\\uFE0F RETIRADA N\\u00C3O CONCLU\\u00CDDA');\n  linhas.push('Status: ' + status);\n  if (api.safeError) linhas.push(api.safeError);\n  const affected = (api.removalScope && api.removalScope.affected) || [];\n  if (affected.length > 0) {\n    linhas.push('');\n    linhas.push('Escopo atual:');\n    for (const item of affected) {\n      linhas.push('\\u2022 ' + (item.interfaceName || item.profileId) + ' \\u2014 ' + (item.customer || 'sem cliente') + ' \\u2014 peer ' + (item.peerAddress || '-') + ' (' + item.runtimeState + ')');\n    }\n  }\n  const nova = (api.scopeConfirmation && api.scopeConfirmation.token) || null;\n  if (nova) {\n    linhas.push('');\n    linhas.push('Nova confirma\\u00E7\\u00E3o v\\u00E1lida at\\u00E9 ' + api.scopeConfirmation.expiresAt + '.');\n  }\n}\nreturn [{ json: {\n  ok: ok,\n  status: status,\n  verified: ok,\n  texto: linhas.join('\\n'),\n  newToken: ((api.scopeConfirmation && api.scopeConfirmation.token) || null),\n  chatId: pedido.chatId,\n  messageId: pedido.messageId,\n} }];"
      },
      "id": "b1000000-0000-4000-8000-000000000008",
      "name": "Montar resultado",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1440,
        -200
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "cond-nova-confirmacao",
              "leftValue": "={{ $json.newToken }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "b1000000-0000-4000-8000-000000000009",
      "name": "Nova confirmação emitida?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1680,
        -200
      ]
    },
    {
      "parameters": {
        "chatId": "={{ $json.chatId }}",
        "messageId": "={{ $json.messageId }}",
        "text": "={{ $json.texto }}",
        "replyMarkup": "inlineKeyboard",
        "inlineKeyboard": {
          "rows": [
            {
              "row": {
                "buttons": [
                  {
                    "text": "CANCELAR",
                    "additionalFields": {
                      "callback_data": "=rmc:{{ $json.newToken }}"
                    }
                  },
                  {
                    "text": "CONFIRMAR RETIRADA DE TODOS",
                    "additionalFields": {
                      "callback_data": "=rmx:{{ $json.newToken }}"
                    }
                  }
                ]
              }
            }
          ]
        },
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "id": "b1000000-0000-4000-8000-000000000010",
      "name": "Telegram: editar com nova confirmação",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1920,
        -300
      ],
      "credentials": {
        "telegramApi": {
          "id": "SUBSTITUIR_CREDENTIAL_ID",
          "name": "Telegram NetVision"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{ $json.chatId }}",
        "messageId": "={{ $json.messageId }}",
        "text": "={{ $json.texto }}",
        "additionalFields": {
          "appendAttribution": false
        },
        "replyMarkup": "none"
      },
      "id": "b1000000-0000-4000-8000-000000000011",
      "name": "Telegram: editar mensagem com resultado",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1920,
        -100
      ],
      "credentials": {
        "telegramApi": {
          "id": "SUBSTITUIR_CREDENTIAL_ID",
          "name": "Telegram NetVision"
        }
      }
    },
    {
      "parameters": {
        "chatId": "={{ $('Interpretar callback').first().json.chatId }}",
        "messageId": "={{ $('Interpretar callback').first().json.messageId }}",
        "text": "=🚫 Retirada cancelada pelo operador {{ $('Interpretar callback').first().json.fromId }}. Nenhuma alteração foi feita no equipamento.",
        "additionalFields": {
          "appendAttribution": false
        },
        "replyMarkup": "none"
      },
      "id": "b1000000-0000-4000-8000-000000000012",
      "name": "Telegram: confirmar cancelamento",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        960,
        0
      ],
      "credentials": {
        "telegramApi": {
          "id": "SUBSTITUIR_CREDENTIAL_ID",
          "name": "Telegram NetVision"
        }
      }
    }
  ],
  "connections": {
    "Entrada (callback do Telegram)": {
