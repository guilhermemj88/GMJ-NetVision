[Unit]
Description=GMJ NetVision Web
After=network.target netvision-api.service

[Service]
Type=simple
WorkingDirectory=/opt/GMJ-NetVision
EnvironmentFile=/opt/GMJ-NetVision/.env
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/env npm run start -w @gmj/web
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

